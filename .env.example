# Copy to .env and load explicitly with: node --env-file=.env src/server.js
# This example restricts local listening; use HOST=0.0.0.0 inside a container.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Replace these placeholders with your bridge origin and exact upstream hostnames.
PUBLIC_BASE_URL=https://bridge.example.com
ALLOWED_TWIML_HOSTS=voice.example.com
ALLOW_PRIVATE_TARGETS=false

# Optional HMAC signing. Set a random secret of at least 32 bytes and regenerate targets.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Protect inbound requests at your proxy even when signing is enabled.
TARGET_SIGNING_SECRET=

MAX_XML_BYTES=262144
FETCH_TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=10000
MAX_CONCURRENT_REQUESTS=64

# Speech Gather defaults. Say always uses the jambonz application's TTS settings.
DEFAULT_STT_VENDOR=
DEFAULT_TTS_LANGUAGE=
# Accepted for compatibility; currently unused because Say overrides are stripped.
DEFAULT_SYNTH_VENDOR=
# Optional websocket recorder for the approximate Record mapping.
RECORDING_WS_URL=
